# ─── Core ──────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────────
# Local development defaults to SQLite so no database server is required.
# Point DATABASE_URL at Postgres when you have one running:
#   DATABASE_URL=postgres://kuyash:kuyash@localhost:5432/kuyash
DATABASE_URL=sqlite:///db.sqlite3

# ─── Cache / Celery ────────────────────────────────────────────────────────────
# Leave REDIS_URL empty for local development: the cache falls back to in-memory
# and Celery runs tasks eagerly (synchronously, in-process). No Redis needed.
REDIS_URL=
# With REDIS_URL empty, WebSocket pushes use an in-memory layer: fine for one
# process (make run), not for several production processes.
CELERY_TASK_ALWAYS_EAGER=True

# ─── Cookies / CORS ────────────────────────────────────────────────────────────
SESSION_COOKIE_DOMAIN=
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Payments (Phase 1E — not yet used) ────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
DEFAULT_PAYMENT_PROVIDER=paystack
PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/complete

# ─── Media: Supabase Storage (leave blank to use local disk in development) ────
SUPABASE_S3_ENDPOINT=
SUPABASE_BUCKET=
SUPABASE_REGION=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
# Optional. Derived from SUPABASE_S3_ENDPOINT + SUPABASE_BUCKET when blank:
# https://<ref>.supabase.co/storage/v1/object/public/<bucket>
SUPABASE_PUBLIC_URL=

# ─── Social login (Phase 2.5) ──────────────────────────────────────────────────
# Leave blank to disable a provider. Google auto-links to an existing account
# because it asserts a verified email; Facebook does not.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Email ─────────────────────────────────────────────────────────────────────
# Development prints emails to the console AND records them in the notifications
# outbox, so the verification link is always recoverable.
DEFAULT_FROM_EMAIL=Kuyash Place <orders@kuyashplace.com>

# Email verification is mandatory everywhere, matching production. Set to
# "optional" only if you genuinely need to skip it locally.
ACCOUNT_EMAIL_VERIFICATION=mandatory

# ─── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# Local development also writes backend/logs/kuyash.log (rotating, 5 MB x 5), so
# you can read back a request after the terminal has scrolled. Set LOG_DIR= to
# switch it off. Deployed environments leave this unset and log to stdout only,
# where the platform collects it.
# LOG_DIR=
# LOG_FILE_FORMAT=json

# Reviews: days a customer may edit a review after posting it.
REVIEW_EDIT_WINDOW_DAYS=7

# Academy: where the payment provider returns students, and how long unpaid seats are held.
ACADEMY_PAYMENT_CALLBACK_URL=http://localhost:3000/academy/enrolment/complete
ACADEMY_CARD_HOLD_MINUTES=30
ACADEMY_TRANSFER_HOLD_HOURS=48

# Kuyash Rewards: kobo spent per base point (10000 = 1 point per ₦100) and days of inactivity before points expire.
LOYALTY_KOBO_PER_POINT=10000
LOYALTY_EXPIRY_INACTIVE_DAYS=365

# Staff must pass an authenticator-app code to use the Django admin (default true).
# Only switch off for local debugging; the deploy check warns (kuyash.W020).
STAFF_MFA_REQUIRED=true

# Proxies in front of Django that append to X-Forwarded-For. 0 locally (the header
# is ignored); 1 behind Nginx or a platform load balancer. kuyash.W021.
TRUSTED_PROXY_COUNT=0

# Optional admin IP allowlist: comma-separated addresses or CIDR ranges. Empty = off.
ADMIN_ALLOWED_IPS=

# Operational alerts (DEPLOYMENT.md §9). Extra recipients for the daily stuck-orders email.
OPS_ALERT_EMAILS=
# OPS_STALE_PAYMENT_ALERT=5
# OPS_STUCK_ORDER_MINUTES=60
# OPS_QUEUE_DEPTH_WARN=100
# OPS_BEAT_STALE_SECONDS=300
