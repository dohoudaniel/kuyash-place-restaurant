# Copy to .env.local for development.

# The Django API, including the /api/v1 prefix.
# NEXT_PUBLIC_ values are inlined into the browser bundle at build time, so
# this must be set correctly for each environment *before* `next build`.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# No payment provider key is needed. Checkout redirects to the provider's hosted
# page using an authorization_url issued by the backend; the browser never
# handles a key or card data.
